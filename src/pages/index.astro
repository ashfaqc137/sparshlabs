---
import Code from '../components/Code.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { projects } from '../data/projects'

const github = 'https://github.com/ashfaqc137'

const principles = [
  {
    title: 'One real problem each',
    body: 'Every project starts from an annoyance people actually hit, and stays small enough to explain in a sentence.',
  },
  {
    title: 'Honest about limits',
    body: 'Docs say what is tested, what is not, and what a tool does not protect you from. No surprises after you adopt it.',
  },
  {
    title: 'Yours to keep',
    body: 'MIT licensed, no accounts, no lock-in. Read the source, run it where you like, fork it if you need to.',
  },
]
---

<BaseLayout title="sparshlabs — small open-source tools that fix one real annoyance">
  <main id="main" class="content-page lab-page">
    <section class="hero">
      <p class="eyebrow"><span class="eyebrow-dot"></span> An open-source lab</p>
      <h1>Small open-source tools<br /><span>that fix one real annoyance.</span></h1>
      <p class="lead">
        sparshlabs is a one-person lab. Each tool solves one problem well, says plainly what it
        doesn’t do, and is free to run yourself.
      </p>
      <div class="hero-actions">
        <a class="button-primary" href="#projects">Explore the projects <span aria-hidden="true">↓</span></a>
        <a class="button-secondary" href="#about">The story</a>
      </div>
    </section>

    <section class="section" id="projects" aria-labelledby="projects-title">
      <div class="section-heading">
        <p class="section-kicker">The projects</p>
        <h2 id="projects-title">Both are early. Both work today.</h2>
      </div>
      <div class="project-grid">
        {projects.map((project) => (
          <article class="project-card">
            <div class="project-top">
              <span class={`project-mark mark-${project.slug}`} aria-hidden="true">{project.slug === 'sparsh' ? 's' : <i></i>}</span>
              <div>
                <h3>{project.name}</h3>
                <p class="project-tagline">{project.tagline}</p>
              </div>
              <span class="project-status">{project.status}</span>
            </div>
            <p class="project-pitch">{project.pitch}</p>
            <ul class="project-points">
              {project.points.map((point) => <li>{point}</li>)}
            </ul>
            <p class="project-limits">
              <a class="inline" href={project.limits.href} rel="noreferrer">{project.limits.label} <span aria-hidden="true">→</span></a>
            </p>
            <div class="project-install">
              <Code label="Install" code={project.install} copyLabel={`Copy the ${project.name} install command`} />
            </div>
            <div class="project-links">
              <a class="button-primary" href={project.site}>Visit {project.name} <span aria-hidden="true">→</span></a>
              <a class="button-secondary" href={project.repo} rel="noreferrer">Source on GitHub</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="split-section" id="about" aria-labelledby="about-title">
      <div class="section-heading">
        <p class="section-kicker">About the lab</p>
        <h2 id="about-title">It started with a tap.</h2>
      </div>
      <div class="prose">
        <p>
          sparshlabs is one developer building tools in the open. It started with <em>sparsh</em>,
          Sanskrit for “touch”: a small library I wrote to stop a tap from landing on the wrong thing
          when an interface moves under someone’s finger.
        </p>
        <p>
          Building it set the bar I now hold every project to: fix a real annoyance, explain it
          plainly, and be pleasant to adopt. That bar outgrew one library, so sparsh
          became <em>sparshlabs</em>: a home for each tool that follows. OwnCI, a self-hosted GitHub
          Actions runner, is the second.
        </p>
        <p>They’re for developers who would rather understand a tool than just trust it.</p>
        <p><a class="inline" href="https://author.sparshlabs.com/">More about me <span aria-hidden="true">→</span></a></p>
      </div>
    </section>

    <section class="section" aria-labelledby="principles-title">
      <div class="section-heading">
        <p class="section-kicker">How I build</p>
        <h2 id="principles-title">Small, honest, and yours.</h2>
      </div>
      <div class="card-grid">
        {principles.map((principle, index) => (
          <article class="card">
            <span class="card-number">0{index + 1}</span>
            <h3>{principle.title}</h3>
            <p>{principle.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="cta-band">
      <span class="cta-spark" aria-hidden="true">◉</span>
      <div><p class="section-kicker">Get involved</p><h2>Found a rough edge?</h2><p>Issues, ideas and pull requests are welcome on either repo.</p></div>
      <a class="button-primary" href={github} rel="noreferrer">sparshlabs on GitHub <span aria-hidden="true">→</span></a>
    </section>
  </main>
</BaseLayout>
